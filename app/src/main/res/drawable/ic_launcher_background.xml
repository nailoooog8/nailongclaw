<?xml version="1.0" encoding="utf-8"?>
<!--
  NailongClaw adaptive-icon background: the diagonal three-stop gradient sampled
  from the reference artwork — periwinkle (top-left) through a mauve highlight
  into rust (bottom-right). Full-bleed so any launcher mask shows pure gradient.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#8A89AD"
        android:centerColor="#C2B6B8"
        android:endColor="#AD6E57" />
</shape>
