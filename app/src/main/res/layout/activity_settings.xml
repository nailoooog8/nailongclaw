<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBgPrimary"
    android:orientation="vertical">

    <io.agents.pokeclaw.widget.CommonToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="44dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <!-- 配置：模型与任务 / 渠道接入 / 监听与权限 -->
            <io.agents.pokeclaw.widget.MenuGroup
                android:id="@+id/configGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- 功能：工具 / MCP / 技能 / 记忆库 -->
            <io.agents.pokeclaw.widget.MenuGroup
                android:id="@+id/featureGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 外观 -->
            <io.agents.pokeclaw.widget.MenuGroup
                android:id="@+id/appearanceGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 系统 -->
            <io.agents.pokeclaw.widget.MenuGroup
                android:id="@+id/systemGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
